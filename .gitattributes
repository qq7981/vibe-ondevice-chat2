# 统一换行符处理：源码在仓库里始终用 LF，检出到 Windows 时再转 CRLF。
# 避免跨平台协作时出现整文件 diff。

* text=auto

*.kt      text eol=lf
*.kts     text eol=lf
*.java    text eol=lf
*.cpp     text eol=lf
*.hpp     text eol=lf
*.h       text eol=lf
*.py      text eol=lf
*.md      text eol=lf
*.xml     text eol=lf
*.json    text eol=lf

# Gradle wrapper 脚本必须有可执行位，且不能被当作文本转换。
gradlew        text eol=lf
gradlew.bat    text eol=crlf

# 二进制文件不做任何转换。
*.so     binary
*.jar    binary
*.apk    binary
*.png    binary
*.gif    binary
*.jpg    binary
